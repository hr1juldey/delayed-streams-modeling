# Voice Server Configuration
# Environment variables for the voice microservice server

# ============================================================================
# SERVER SETTINGS
# ============================================================================
VOICE_SERVER__HOST=0.0.0.0
VOICE_SERVER__PORT=16000
VOICE_SERVER__API_VERSION=v1

# CORS origins (comma-separated list, use "*" for all)
VOICE_SERVER__CORS_ORIGINS=["*"]

# API keys (comma-separated list of valid keys)
# Leave empty to disable authentication
VOICE_SERVER__API_KEYS=[]

# Maximum concurrent WebSocket sessions
VOICE_SERVER__MAX_CONCURRENT_SESSIONS=10

# Enable WebSocket permessage-deflate compression
VOICE_SERVER__WEBSOCKET_COMPRESSION=true

# Heartbeat interval in seconds for connection health monitoring
VOICE_SERVER__HEARTBEAT_INTERVAL_SECONDS=30

# Storage paths
VOICE_SERVER__VOICES_PATH=./data/voices
VOICE_SERVER__DB_PATH=./data/db

# ============================================================================
# AUDIO SETTINGS
# ============================================================================
# Audio chunk size in samples (1920 = 80ms at 24kHz)
VOICE_SERVER__AUDIO__CHUNK_SIZE=1920

# Input audio sample rate
VOICE_SERVER__AUDIO__INPUT_SAMPLE_RATE=24000

# Output audio sample rate
VOICE_SERVER__AUDIO__OUTPUT_SAMPLE_RATE=24000

# Input audio format (float32 or int16)
VOICE_SERVER__AUDIO__INPUT_FORMAT=float32

# ============================================================================
# STT (Speech-to-Text) SETTINGS
# ============================================================================
# Model selection: "1b-en_fr" or "2.6b-en"
VOICE_SERVER__STT__MODEL_NAME=1b-en_fr

# Device for STT model ("cuda" or "cpu")
VOICE_SERVER__STT__DEVICE=cuda

# Preload STT model on startup
VOICE_SERVER__STT__PRELOAD_MODEL=true

# Warm up STT model on startup (run inference to initialize)
VOICE_SERVER__STT__WARMUP_ON_STARTUP=true

# VAD mode: "client" or "server"
VOICE_SERVER__STT__VAD_MODE=client

# Streaming mode: "partial", "final", or "both"
VOICE_SERVER__STT__STREAMING_MODE=both

# Confidence threshold for STT results (0.0 to 1.0)
VOICE_SERVER__STT__CONFIDENCE_THRESHOLD=0.5

# Target latency in milliseconds for STT first token
VOICE_SERVER__STT__TARGET_LATENCY_MS=200

# Custom vocabulary words (comma-separated)
VOICE_SERVER__STT__CUSTOM_VOCABULARY=[]

# ============================================================================
# TTS (Text-to-Speech) SETTINGS
# ============================================================================
# Default voice name
VOICE_SERVER__TTS__DEFAULT_VOICE=default

# Device for TTS model (always "cpu" for Pocket TTS)
VOICE_SERVER__TTS__DEVICE=cpu

# Preload TTS model on startup
VOICE_SERVER__TTS__PRELOAD_MODEL=true

# Enable audio normalization for TTS output
VOICE_SERVER__TTS__ENABLE_NORMALIZATION=true

# Voice speed multiplier (1.0 = normal, 0.5 = half speed, 2.0 = double speed)
VOICE_SERVER__TTS__SPEED=1.0

# Voice stability/CFG coefficient (higher = more consistent)
VOICE_SERVER__TTS__STABILITY=1.0

# Voice pitch multiplier (1.0 = normal, 0.5 = lower, 2.0 = higher)
VOICE_SERVER__TTS__PITCH=1.0

# ============================================================================
# SESSION SETTINGS
# ============================================================================
# Session timeout in minutes (0 = no timeout)
VOICE_SERVER__SESSION__TIMEOUT_MINUTES=30

# Storage backend: "sqlite" or "memory"
VOICE_SERVER__SESSION__STORAGE_BACKEND=sqlite

# Enable session recovery (resume with same session_id)
VOICE_SERVER__SESSION__RECOVERY_ENABLED=true

# Require conversation history field
VOICE_SERVER__SESSION__HISTORY_REQUIRED=true

# Maximum history length per session
VOICE_SERVER__SESSION__MAX_HISTORY_LENGTH=1000

# ============================================================================
# LOGGING SETTINGS
# ============================================================================
# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
VOICE_SERVER_LOG__LEVEL=INFO

# Use JSON format for console logging
VOICE_SERVER_LOG__JSON_FORMAT=true

# Enable file logging
VOICE_SERVER_LOG__FILE_ENABLED=true

# File logging path
VOICE_SERVER_LOG__FILE_PATH=./logs/voice-server.log

# Max file size before rotation (bytes)
VOICE_SERVER_LOG__MAX_BYTES=10485760

# Number of backup files to keep
VOICE_SERVER_LOG__BACKUP_COUNT=5
